# FinPilot — required environment variables
# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env to git — it is already in .gitignore.

# -----------------------------------------------------------------------
# Backend — Spring Boot
# -----------------------------------------------------------------------

# REQUIRED — JWT signing key. Use a random string of at least 32 characters.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# REQUIRED — PostgreSQL password for the finpilot database.
SPRING_DATASOURCE_PASSWORD=your-postgres-password

# Optional — override the database connection URL (default: localhost:5432/finpilot)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finpilot

# Optional — override the database username (default: postgres)
# SPRING_DATASOURCE_USERNAME=postgres

# REQUIRED in production — comma-separated list of frontend origins allowed
# to call the API. In local dev the Vite proxy means this is not needed.
# APP_CORS_ALLOWED_ORIGINS=https://yourapp.com

# Optional — enables AI narrative (/intelligence/narrative) and Ask FinPilot
# (/intelligence/ask). If not set, both endpoints return 503 and all other
# features continue to work normally. Get a key at platform.openai.com/api-keys.
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------
# Frontend — Vite
# (add VITE_* variables here if you ever move the API base URL to an env var)
# -----------------------------------------------------------------------
# (no frontend env vars required currently — the API base URL is configured
#  in vite.config.ts via the dev proxy and hardcoded as /api/v1 in apiClient.ts)
